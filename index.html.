<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Future-Trades.nft — modern digital asset and crypto technology platform.">
<title>Future-Trades.nft | Digital Asset Platform</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --bg:#211d43;
    --bg-dark:#11102b;
    --card:#12102b;
    --card2:#181536;
    --purple:#75117f;
    --purple2:#9b168f;
    --pink:#e50083;
    --yellow:#ffe000;
    --text:#ffffff;
    --muted:#9691b2;
    --border:#484268;
    --success:#39d98a;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:var(--bg);
    color:var(--text);
    overflow-x:hidden;
}

a{
    color:inherit;
    text-decoration:none;
}

button,
input{
    font-family:inherit;
}

/* ================= HEADER ================= */

.top-header{
    background:linear-gradient(100deg,#3d174d,#78117e,#43194f);
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 5px 25px rgba(0,0,0,.25);
}

.navbar{
    max-width:1250px;
    margin:auto;
    min-height:78px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:12px 25px;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
    font-weight:900;
    font-size:20px;
    letter-spacing:.5px;
}

.logo-icon{
    width:43px;
    height:43px;
    border-radius:12px;
    border:2px solid var(--yellow);
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--yellow);
    font-size:22px;
    box-shadow:0 0 15px rgba(255,224,0,.15);
}

.logo span{
    color:var(--yellow);
}

.nav-links{
    display:flex;
    align-items:center;
    gap:25px;
}

.nav-links a{
    font-size:12px;
    font-weight:bold;
    text-transform:uppercase;
    transition:.25s;
}

.nav-links a:hover{
    color:var(--yellow);
}

.nav-actions{
    display:flex;
    gap:10px;
}

.btn-outline{
    background:transparent;
    color:white;
    border:1px solid var(--pink);
    border-radius:25px;
    padding:11px 19px;
    font-size:12px;
    font-weight:bold;
    cursor:pointer;
}

.btn-outline.yellow{
    border-color:var(--yellow);
}

.btn-outline:hover{
    background:var(--pink);
}

.btn-outline.yellow:hover{
    background:var(--yellow);
    color:#16132c;
}

.menu-btn{
    display:none;
    border:0;
    background:none;
    color:white;
    font-size:28px;
    cursor:pointer;
}

/* ================= TOP INFO ================= */

.info-bar{
    background:#76147e;
    border-top:1px solid rgba(255,255,255,.05);
}

.info-inner{
    max-width:1250px;
    margin:auto;
    padding:12px 25px;
    display:flex;
    align-items:center;
    gap:70px;
}

.info-item{
    display:flex;
    align-items:center;
    gap:10px;
    color:#ddd8e9;
    font-size:11px;
}

.info-icon{
    font-size:20px;
    color:var(--yellow);
}

.info-label{
    color:#aaa4bd;
    text-transform:uppercase;
    font-size:8px;
    margin-bottom:3px;
}

.info-value{
    font-weight:bold;
}

/* ================= HERO ================= */

.hero{
    min-height:610px;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 80% 40%,rgba(120,20,150,.55),transparent 28%),
        radial-gradient(circle at 15% 60%,rgba(175,0,115,.28),transparent 35%),
        linear-gradient(135deg,#231b48,#211b43);
}

.hero::before{
    content:"";
    position:absolute;
    width:600px;
    height:600px;
    border-radius:50%;
    border:80px solid rgba(125,30,145,.12);
    left:-200px;
    top:80px;
}

.hero::after{
    content:"";
    position:absolute;
    width:700px;
    height:700px;
    border-radius:50%;
    border:80px solid rgba(0,0,0,.18);
    right:-350px;
    top:40px;
}

.hero-content{
    max-width:1250px;
    margin:auto;
    padding:80px 25px 100px;
    display:grid;
    grid-template-columns:1fr 1fr;
    align-items:center;
    position:relative;
    z-index:2;
}

.hero-text{
    max-width:620px;
}

.eyebrow{
    display:inline-block;
    color:var(--yellow);
    border-left:3px solid var(--yellow);
    padding-left:10px;
    font-size:12px;
    font-weight:bold;
    text-transform:uppercase;
    margin-bottom:20px;
}

.hero h1{
    font-size:58px;
    line-height:1.05;
    margin-bottom:25px;
    font-weight:900;
}

.hero h1 span{
    color:var(--yellow);
}

.hero p{
    color:#d2cedf;
    line-height:1.8;
    max-width:520px;
    font-size:15px;
    margin-bottom:32px;
}

.main-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:180px;
    padding:15px 28px;
    background:linear-gradient(90deg,#8e0e87,#a81182);
    border:2px solid var(--yellow);
    color:white;
    border-radius:30px;
    font-weight:900;
    font-size:13px;
    cursor:pointer;
    box-shadow:0 0 0 5px rgba(255,224,0,.08);
    transition:.3s;
}

.main-btn:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 30px rgba(255,224,0,.18);
}

.hero-visual{
    min-height:420px;
    display:flex;
    justify-content:center;
    align-items:center;
    position:relative;
}

.crypto-orb{
    width:350px;
    height:350px;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    position:relative;
    background:
        radial-gradient(circle,#ffe8a0 0 7%,#df7a2e 8% 14%,#281c45 15% 29%,#9b3b2a 30% 32%,#191734 33% 43%,#f17b19 44% 46%,#1d1837 47% 60%,#a33b89 61% 62%,#17152f 63% 100%);
    box-shadow:
        0 0 50px rgba(255,117,0,.35),
        0 0 100px rgba(168,0,150,.25);
    animation:orbFloat 5s ease-in-out infinite;
}

.crypto-orb::before,
.crypto-orb::after{
    content:"";
    position:absolute;
    border-radius:50%;
    border:2px dashed rgba(255,224,0,.45);
}

.crypto-orb::before{
    inset:28px;
    animation:spin 12s linear infinite;
}

.crypto-orb::after{
    inset:70px;
    border-color:rgba(255,255,255,.3);
    animation:spinReverse 8s linear infinite;
}

.bitcoin{
    width:105px;
    height:105px;
    border-radius:50%;
    background:linear-gradient(145deg,#fff4bd,#e4a137);
    color:#9b5b13;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:65px;
    font-weight:bold;
    box-shadow:0 0 35px rgba(255,210,80,.65);
    z-index:2;
}

.coin-orbit{
    position:absolute;
    width:480px;
    height:150px;
    border:2px solid rgba(255,173,42,.3);
    border-radius:50%;
    transform:rotate(-25deg);
}

@keyframes spin{
    to{transform:rotate(360deg)}
}

@keyframes spinReverse{
    to{transform:rotate(-360deg)}
}

@keyframes orbFloat{
    0%,100%{transform:translateY(0)}
    50%{transform:translateY(-12px)}
}

/* ================= TICKER ================= */

.ticker{
    position:absolute;
    bottom:25px;
    left:50%;
    transform:translateX(-50%);
    width:min(900px,90%);
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:12px;
    z-index:4;
}

.ticker-item{
    background:rgba(16,13,43,.8);
    border:1px solid #3c375b;
    padding:13px 8px;
    text-align:center;
    border-radius:12px;
    backdrop-filter:blur(10px);
}

.ticker-symbol{
    width:36px;
    height:36px;
    margin:0 auto 7px;
    border-radius:50%;
    background:#292441;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--yellow);
    font-weight:bold;
}

.ticker-name{
    font-size:10px;
    color:#aaa5bb;
}

.ticker-price{
    font-size:11px;
    font-weight:bold;
    margin:4px 0;
}

.ticker-change{
    font-size:9px;
    color:var(--success);
}

/* ================= SECTIONS ================= */

.section{
    max-width:1180px;
    margin:auto;
    padding:90px 25px;
}

.section-title{
    text-align:center;
    margin-bottom:50px;
}

.section-title h2{
    font-size:35px;
    margin-bottom:12px;
}

.section-title h2 span{
    color:var(--yellow);
}

.section-title p{
    max-width:700px;
    margin:auto;
    color:var(--muted);
    font-size:14px;
    line-height:1.7;
}

/* ================= PLANS ================= */

.plans{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.plan{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:9px;
    padding:22px 15px;
    text-align:center;
    transition:.3s;
    position:relative;
    overflow:hidden;
}

.plan:hover{
    transform:translateY(-7px);
    border-color:var(--yellow);
}

.plan.featured{
    border:2px solid var(--yellow);
}

.plan-icon{
    width:42px;
    height:42px;
    margin:0 auto 14px;
    border-radius:50%;
    border:2px solid var(--yellow);
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--yellow);
}

.plan h3{
    font-size:11px;
    color:#8c87a8;
    text-transform:uppercase;
    letter-spacing:.5px;
    min-height:30px;
}

.plan-rate{
    font-size:30px;
    font-weight:900;
    color:var(--yellow);
    margin:5px 0 20px;
}

.plan-line{
    display:flex;
    justify-content:space-between;
    padding:10px 0;
    border-bottom:1px solid #292541;
    font-size:10px;
}

.plan-line span:first-child{
    color:#77728f;
}

.plan-line span:last-child{
    font-weight:bold;
}

.plan-note{
    background:#25213c;
    color:#bbb5c9;
    padding:10px;
    margin-top:14px;
    border-radius:5px;
    font-size:9px;
}

.plan-btn{
    margin-top:20px;
    border:2px solid var(--yellow);
    background:transparent;
    color:white;
    padding:10px 23px;
    border-radius:22px;
    cursor:pointer;
    font-size:10px;
    font-weight:bold;
}

.plan-btn:hover{
    background:var(--yellow);
    color:#18152d;
}

/* ================= CALCULATOR ================= */

.calculator-wrap{
    display:flex;
    justify-content:center;
    padding:20px 0 70px;
}

.calculator{
    width:430px;
    background:#12102b;
    border:1px solid var(--border);
    border-radius:9px;
    padding:30px;
    text-align:center;
    box-shadow:0 20px 50px rgba(0,0,0,.2);
}

.calculator label{
    display:block;
    color:#9993ad;
    font-size:10px;
    text-transform:uppercase;
    font-weight:bold;
    margin-bottom:10px;
}

.amount-input{
    width:100%;
    background:#24203f;
    color:white;
    border:1px solid #4b4667;
    border-radius:7px;
    padding:14px;
    text-align:center;
    outline:none;
    margin-bottom:20px;
}

.amount-input:focus{
    border-color:var(--yellow);
}

.calc-results{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
    margin-bottom:20px;
}

.calc-result{
    padding:15px;
    background:#1b1835;
    border-radius:7px;
}

.calc-result small{
    color:#8f89a5;
    font-size:9px;
}

.calc-result strong{
    display:block;
    font-size:24px;
    color:var(--yellow);
    margin-top:5px;
}

.disclaimer{
    max-width:800px;
    margin:0 auto;
    padding:15px 20px;
    background:rgba(255,224,0,.05);
    border:1px solid rgba(255,224,0,.18);
    border-radius:8px;
    color:#aaa5b8;
    font-size:11px;
    line-height:1.7;
    text-align:center;
}

/* ================= ABOUT ================= */

.about{
    background:
        radial-gradient(circle at 15% 50%,rgba(140,10,140,.18),transparent 35%),
        #1d193c;
}

.about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
}

.about h2{
    font-size:36px;
    margin-bottom:20px;
}

.about h2 span{
    color:var(--yellow);
}

.about p{
    color:#aaa5ba;
    font-size:14px;
    line-height:1.9;
    margin-bottom:18px;
}

.about-boxes{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.about-box{
    background:#13112d;
    border:1px solid #393454;
    border-radius:10px;
    padding:25px 18px;
}

.about-box strong{
    color:var(--yellow);
    font-size:26px;
    display:block;
    margin-bottom:8px;
}

.about-box span{
    color:#8d879f;
    font-size:11px;
}

/* ================= FEATURES ================= */

.features{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.feature{
    background:#13112d;
    border:1px solid var(--border);
    border-radius:10px;
    padding:30px 24px;
    transition:.3s;
}

.feature:hover{
    border-color:var(--yellow);
    transform:translateY(-5px);
}

.feature-icon{
    font-size:30px;
    color:var(--yellow);
    margin-bottom:15px;
}

.feature h3{
    margin-bottom:10px;
}

.feature p{
    color:#8f899f;
    font-size:12px;
    line-height:1.8;
}

/* ================= FAQ ================= */

.faq{
    max-width:850px;
    margin:auto;
}

.faq-item{
    border:1px solid var(--border);
    margin-bottom:10px;
    border-radius:7px;
    overflow:hidden;
    background:#13112d;
}

.faq-question{
    width:100%;
    border:0;
    background:none;
    color:white;
    padding:20px;
    display:flex;
    justify-content:space-between;
    text-align:left;
    cursor:pointer;
    font-weight:bold;
}

.faq-question span{
    color:var(--yellow);
    font-size:20px;
}

.faq-answer{
    display:none;
    padding:0 20px 20px;
    color:#9590a9;
    font-size:13px;
    line-height:1.7;
}

.faq-item.active .faq-answer{
    display:block;
}

/* ================= CONTACT ================= */

.contact{
    background:linear-gradient(120deg,#451050,#761277,#42104d);
}

.contact-inner{
    max-width:850px;
    margin:auto;
    text-align:center;
}

.contact h2{
    font-size:38px;
    margin-bottom:15px;
}

.contact p{
    color:#ddd6e3;
    line-height:1.7;
    font-size:14px;
    margin-bottom:30px;
}

/* ================= FOOTER ================= */

footer{
    background:#0d0c20;
    padding:55px 25px 25px;
}

.footer-grid{
    max-width:1180px;
    margin:auto;
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1fr;
    gap:50px;
    padding-bottom:40px;
}

.footer-brand p{
    color:#79748e;
    font-size:12px;
    line-height:1.8;
    max-width:350px;
    margin-top:15px;
}

footer h4{
    margin-bottom:18px;
    color:white;
}

footer ul{
    list-style:none;
}

footer li{
    margin-bottom:11px;
}

footer li a{
    color:#7f7a90;
    font-size:12px;
}

footer li a:hover{
    color:var(--yellow);
}

.copyright{
    border-top:1px solid #24213a;
    padding-top:20px;
    text-align:center;
    color:#676277;
    font-size:10px;
}

/* ================= MODAL ================= */

.modal{
    position:fixed;
    inset:0;
    background:rgba(4,3,15,.82);
    backdrop-filter:blur(8px);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:3000;
    padding:20px;
}

.modal.show{
    display:flex;
}

.modal-box{
    width:440px;
    max-width:100%;
    max-height:90vh;
    overflow-y:auto;
    background:#11102a;
    border:1px solid #4c466c;
    border-radius:12px;
    padding:32px;
    position:relative;
}

.close-modal{
    position:absolute;
    top:14px;
    right:17px;
    color:#aaa;
    background:none;
    border:0;
    font-size:25px;
    cursor:pointer;
}

.modal-logo{
    text-align:center;
    margin-bottom:20px;
}

.modal-logo .logo-icon{
    margin:auto;
}

.modal h2{
    text-align:center;
    font-size:25px;
    margin-bottom:7px;
}

.modal-sub{
    text-align:center;
    color:#79748e;
    font-size:11px;
    margin-bottom:25px;
}

.form-group{
    margin-bottom:16px;
}

.form-group label{
    display:block;
    font-size:11px;
    font-weight:bold;
    margin-bottom:8px;
}

.form-group input{
    width:100%;
    padding:14px;
    border-radius:25px;
    background:#211d3e;
    border:1px solid #4a4567;
    color:white;
    outline:none;
}

.form-group input:focus{
    border-color:var(--yellow);
}

.checkbox{
    display:flex;
    align-items:center;
    gap:8px;
    color:#858097;
    font-size:10px;
    margin:10px 0 20px;
}

.checkbox input{
    accent-color:var(--yellow);
}

.modal-btn{
    width:100%;
    padding:15px;
    border:0;
    background:var(--yellow);
    color:#111027;
    border-radius:25px;
    font-weight:900;
    cursor:pointer;
}

.modal-switch{
    text-align:center;
    color:#77728d;
    font-size:11px;
    margin-top:20px;
}

.modal-switch a{
    color:var(--yellow);
    font-weight:bold;
    cursor:pointer;
}

/* ================= TOAST ================= */

.toast{
    position:fixed;
    right:20px;
    bottom:20px;
    background:#11102b;
    border:1px solid var(--yellow);
    color:white;
    padding:15px 20px;
    border-radius:8px;
    z-index:5000;
    transform:translateY(120px);
    transition:.4s;
    font-size:12px;
    box-shadow:0 10px 35px rgba(0,0,0,.4);
}

.toast.show{
    transform:translateY(0);
}

/* ================= MOBILE ================= */

@media(max-width:950px){

    .nav-links{
        position:absolute;
        top:78px;
        left:0;
        right:0;
        background:#401347;
        display:none;
        flex-direction:column;
        padding:25px;
        gap:20px;
        border-top:1px solid rgba(255,255,255,.1);
    }

    .nav-links.active{
        display:flex;
    }

    .menu-btn{
        display:block;
    }

    .nav-actions{
        display:none;
    }

    .hero-content{
        grid-template-columns:1fr;
        text-align:center;
        padding-top:55px;
    }

    .hero-text{
        margin:auto;
    }

    .hero p{
        margin-left:auto;
        margin-right:auto;
    }

    .hero h1{
        font-size:43px;
    }

    .hero-visual{
        min-height:350px;
    }

    .crypto-orb{
        width:280px;
        height:280px;
    }

    .coin-orbit{
        width:380px;
    }

    .ticker{
        position:relative;
        bottom:auto;
        left:auto;
        transform:none;
        margin:-45px auto 0;
        grid-template-columns:repeat(5,1fr);
    }

    .plans{
        grid-template-columns:repeat(2,1fr);
    }

    .about-grid{
        grid-template-columns:1fr;
    }

    .features{
        grid-template-columns:1fr 1fr;
    }

    .footer-grid{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:600px){

    .navbar{
        min-height:68px;
        padding:10px 16px;
    }

    .logo{
        font-size:16px;
    }

    .logo-icon{
        width:37px;
        height:37px;
    }

    .nav-links{
        top:68px;
    }

    .info-inner{
        gap:18px;
        overflow:hidden;
        padding:10px 15px;
    }

    .info-item{
        min-width:max-content;
    }

    .hero{
        min-height:auto;
    }

    .hero-content{
        padding:45px 18px 55px;
    }

    .hero h1{
        font-size:38px;
    }

    .hero p{
        font-size:13px;
    }

    .hero-visual{
        min-height:300px;
    }

    .crypto-orb{
        width:230px;
        height:230px;
    }

    .bitcoin{
        width:75px;
        height:75px;
        font-size:45px;
    }

    .coin-orbit{
        width:300px;
        height:110px;
    }

    .ticker{
        width:94%;
        overflow-x:auto;
        grid-template-columns:repeat(5,100px);
        padding-bottom:8px;
    }

    .section{
