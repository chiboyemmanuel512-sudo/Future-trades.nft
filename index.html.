<script>

/* ================= MOBILE MENU ================= */

const menuBtn = document.getElementById("menuBtn");
const navLinks = document.getElementById("navLinks");

menuBtn.addEventListener("click",function(){
    navLinks.classList.toggle("active");
});

document.querySelectorAll(".nav-links a").forEach(link=>{
    link.addEventListener("click",()=>{
        navLinks.classList.remove("active");
    });
});


/* ================= CLOCK ================= */

function updateClock(){

    const now = new Date();

    const time =
        now.getHours().toString().padStart(2,"0") + ":" +
        now.getMinutes().toString().padStart(2,"0") + ":" +
        now.getSeconds().toString().padStart(2,"0");

    document.getElementById("clock").textContent = time;
}

updateClock();
setInterval(updateClock,1000);


/* ================= CALCULATOR ================= */

function calculate(){

    const amount =
        parseFloat(document.getElementById("amount").value) || 0;

    const exampleProfit = amount * 0.05;

    document.getElementById("profit").textContent =
        "$" + exampleProfit.toFixed(2);
}

calculate();


/* ================= MODAL ================= */

const modal = document.getElementById("accountModal");

function openModal(type){

    modal.classList.add("show");

    switchForm(type);
}

function closeModal(){

    modal.classList.remove("show");
}

function switchForm(type){

    const login = document.getElementById("loginForm");
    const register = document.getElementById("registerForm");

    if(type === "login"){

        login.style.display = "block";
        register.style.display = "none";

    }else{

        login.style.display = "none";
        register.style.display = "block";
    }
}

window.addEventListener("click",function(e){

    if(e.target === modal){
        closeModal();
    }

});


/* ================= DEMO ACTIONS ================= */

function demoLogin(){

    showToast(
        "Demo login only — connect a secure backend before using real accounts."
    );
}

function demoRegister(){

    showToast(
        "Demo registration only — no account or password has been stored."
    );
}

function showDemo(){

    showToast(
        "This is a demonstration interface. Real transactions require a secure backend."
    );
}

function showToast(message){

    const toast = document.getElementById("toast");

    toast.textContent = message;
    toast.classList.add("show");

    setTimeout(()=>{
        toast.classList.remove("show");
    },4000);
}


/* ================= FAQ ================= */

document.querySelectorAll(".faq-question").forEach(question=>{

    question.addEventListener("click",function(){

        const item = this.parentElement;

        document.querySelectorAll(".faq-item").forEach(other=>{

            if(other !== item){
                other.classList.remove("active");
            }

        });

        item.classList.toggle("active");

        const symbol = this.querySelector("span");

        symbol.textContent =
            item.classList.contains("active") ? "−" : "+";
    });

});


/* ================= CLOSE MODAL WITH ESC ================= */

document.addEventListener("keydown",function(e){

    if(e.key === "Escape"){
        closeModal();
    }

});

</script>

